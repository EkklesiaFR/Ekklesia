rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPERS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function rootMemberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }


    function rootExists() {
      return isSignedIn() && exists(rootMemberPath(request.auth.uid));
    }


    function rootData() {
      return get(rootMemberPath(request.auth.uid)).data;
    }


    // ROOT
    function isMemberActiveRoot() {
      return rootExists() && rootData().status == "active";
    }

    function isAdminActiveRoot() {
      return rootExists()
        && rootData().status == "active"
        && rootData().role == "admin";
    }

    // ASSEMBLY
    function isMemberActive(assemblyId) {
      return isMemberActiveRoot();
    }

    function isAdminActive(assemblyId) {
      return isAdminActiveRoot();
    }

    // =========================
    // MEMBERS (root)
    // =========================
    match /members/{uid} {
      allow get: if isSelf(uid) || isAdminActiveRoot();
      allow list: if isAdminActiveRoot();

      allow create: if isSelf(uid)
        && request.resource.data.role == "member"
        && request.resource.data.status == "pending";

      /**
       * L'utilisateur peut mettre à jour uniquement certains champs
       * de son propre profil, sans pouvoir modifier son rôle ni son statut.
       *
       * Champs autorisés :
       * - photoURL
       * - displayName
       * - email
       * - lastLoginAt
       * - updatedAt
       * - bio
       */
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "photoURL",
          "displayName",
          "email",
          "lastLoginAt",
          "updatedAt",
          "bio"
        ]);

      // Les admins peuvent tout modifier / supprimer
      allow update, delete: if isAdminActiveRoot();

      // -------------------------
      // NOTIFICATIONS
      // -------------------------
      match /notifications/{notificationId} {
        allow get, list: if isSelf(uid);

        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "read"
          ])
          && request.resource.data.read is bool;

        allow create, delete: if false;
      }
    }

    // =========================
    // ASSEMBLIES
    // =========================
    match /assemblies/{assemblyId} {
      allow get, list: if isSignedIn();
      allow create: if isAdminActiveRoot()
        && request.resource.data.state == 'draft'
        && request.resource.data.get('activeVoteId', null) == null
        && request.resource.data.keys().hasOnly(['title', 'state', 'createdAt', 'createdBy', 'updatedAt', 'startsAt', 'endsAt', 'activeVoteId']);
      allow update: if isAdminActiveRoot()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'startsAt', 'endsAt']);
      allow delete: if false;

      // -------------------------
      // PRESENCE
      // -------------------------
      match /presence/{uid} {
        allow get, list: if isMemberActive(assemblyId);

        allow create, update: if isMemberActive(assemblyId)
          && isSelf(uid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "uid",
            "status",
            "sessionId",
            "lastSeenAt",
            "photoURL",
            "displayName"
          ])
          && (request.resource.data.status in ["online", "offline"])
          && (request.resource.data.lastSeenAt is timestamp);

        allow delete: if false;
      }

      // -------------------------
      // MEMBERS MIRROR
      // -------------------------
      match /members/{uid} {
        allow get: if isSelf(uid) || isAdminActive(assemblyId);
        allow list: if isAdminActive(assemblyId);
        allow create, update, delete: if isAdminActive(assemblyId);
      }

      // -------------------------
      // PUBLIC DOCS
      // -------------------------
      match /public/{docId} {
        allow get, list: if true;
        allow write: if false;
      }

      // =========================
      // VOTES
      // =========================
      match /votes/{voteId} {
        allow get, list: if isMemberActive(assemblyId);

        // Client prepares drafts only; lifecycle, counts and results belong to the server.
        function draftFields() {
          return ['assemblyId', 'question', 'title', 'projectIds', 'state', 'createdAt',
            'updatedAt', 'createdBy', 'opensAt', 'closesAt', 'quorumPct', 'deadlineEnforced', 'eligibilityPolicy', 'rulesVersion'];
        }
        allow create: if isAdminActiveRoot()
          && request.resource.data.state == 'draft'
          && request.resource.data.eligibilityPolicy == 'snapshot-active-v1'
          && request.resource.data.rulesVersion == 1
          && request.resource.data.keys().hasOnly(draftFields());
        allow update: if isAdminActiveRoot()
          && resource.data.state == 'draft'
          && request.resource.data.state == 'draft'
          && request.resource.data.get('eligibilityPolicy', null) == resource.data.get('eligibilityPolicy', null)
          && request.resource.data.get('rulesVersion', null) == resource.data.get('rulesVersion', null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(draftFields());

        allow delete: if false;

        // =========================
        // BALLOTS
        // =========================
        match /ballots/{uid} {

          allow get: if isMemberActive(assemblyId) && isSelf(uid);

          allow create, update: if false;
          allow list: if false;

          allow delete: if false;
        }
      }
    }

    // =========================
    // PROJECTS (root)
    // =========================
    match /projects/{projectId} {
      allow get, list: if isMemberActiveRoot();
      allow create: if isMemberActiveRoot();

      allow update, delete: if isAdminActiveRoot()
        || (
          isSignedIn()
          && request.auth.uid == resource.data.ownerUid
          && resource.data.status == "submitted"
        );
    }

    // =========================
    // DEFAULT DENY
    // =========================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
